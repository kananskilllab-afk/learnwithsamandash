# Server
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Razorpay (get these from the Razorpay dashboard)
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=your_key_secret_here

# MongoDB Atlas — primary lead/purchase storage.
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster-host>"
MONGODB_DB_NAME=lwsa

# CRM — TODO: point this at your real CRM's inbound webhook/API.
# Until it's set, leads are stored in MongoDB (falling back to
# server/data/leads.json if the database is unreachable).
CRM_WEBHOOK_URL=

# Support contact shown in error/fallback messages
SUPPORT_EMAIL=support@learnwithsamandash.com
SUPPORT_WHATSAPP=+91-00000-00000
